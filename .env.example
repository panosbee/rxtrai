# RxTrail — Environment Variables (example)
# Copy this to .env and fill in your real values

# ── MongoDB ─────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=rxtrail

# ── JWT ────────────────────────────────────────────
JWT_SECRET=generate-with-python-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_HOURS=168

# ── DeepSeek V4 ────────────────────────────────────
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_DEEP=deepseek-v4-pro
DEEPSEEK_THINKING=false

# ── Jina ───────────────────────────────────────────
JINA_API_KEY=jina_your_key_here
JINA_EMBEDDINGS_URL=https://api.jina.ai/v1/embeddings
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
JINA_EMBEDDINGS_MODEL=jina-embeddings-v3

# ── App ────────────────────────────────────────────
CORS_ORIGINS=https://rxtrail.top,https://www.rxtrail.top,http://localhost:8000
UPLOAD_DIR=uploads
LANGUAGE=el
LLM_TIMEOUT_SECONDS=30
PHOTO_RETENTION_DAYS=30
BRAVE_SEARCH_API_KEY=BS-your-key-here

# ── Server ─────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
